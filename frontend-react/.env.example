# Vite environment variables
# Copy this file to ".env" and adjust if your backend runs on a different host/port:
#   copy .env.example .env   (Windows)
#   cp .env.example .env      (Linux/macOS)

# Backend API base URL (used by axios instance)
VITE_BACKEND_BASE_API=http://127.0.0.1:8000/api/v1

# Backend root URL (used to build full image/plot URLs)
VITE_BACKEND_ROOT=http://127.0.0.1:8000
